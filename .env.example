# ===================================================
# FoodWaste AI - Environment Configuration Template
# ===================================================
# Copy this file to .env for local development:
# cp .env.example .env
# NOTE: Never commit .env to version control!

# Server Configuration
PORT=8080
APP_ENV=development
APP_SECRET=change_this_to_a_secure_random_string_in_production

# MySQL Database (Aiven or Local)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=foodwaste_ai
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_SSL_MODE=PREFERRED

# SWI-Prolog Executable Path
# On Linux/Docker/Railway: swipl
# On Windows: C:\Program Files\swipl\bin\swipl.exe (or swipl if added to PATH)
SWIPL_PATH=swipl

# Database Connection Pool Settings
DB_POOL_MIN_IDLE=2
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT=30000
