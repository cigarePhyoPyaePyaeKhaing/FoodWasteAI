# =====================================================================
# FoodWaste AI - Environment Configuration Template
# =====================================================================
# Copy this file to .env for local development:
# cp .env.example .env
# NOTE: Never commit .env or secrets to version control!

# Application Configuration
PORT=8088
APP_ENV=development
APP_SECRET=foodwaste_ai_production_secret_key_change_me_2026

# MySQL Database Configuration (Aiven Cloud or Local)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=foodwaste_ai
DB_USER=root
DB_PASSWORD=your_password_here
# SSL Mode: REQUIRED for Aiven Cloud MySQL, PREFERRED or DISABLED for local development
DB_SSL_MODE=PREFERRED

# Database Connection Pool Settings (HikariCP)
DB_POOL_MIN_IDLE=2
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT=30000

# Google Gemini Generative AI Configuration
# Optional: Get an API key from Google AI Studio (https://aistudio.google.com/)
# If omitted or offline, the system seamlessly uses Prolog-grounded explainable AI fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# SWI-Prolog Executable Path
# Linux / Docker / Railway: swipl
# Windows: C:\Program Files\swipl\bin\swipl.exe (or swipl if on PATH)
SWIPL_PATH=swipl
